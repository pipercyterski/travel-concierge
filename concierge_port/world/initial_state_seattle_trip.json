  "advisory_doc": {
    "ADV-HAN-VISA": {
      "destination_id": "HAN",
      "topic": "visa",
      "title": "Vietnam e-visa required for US passport holders",
      "content": "US passport holders must obtain a Vietnam e-visa BEFORE departure; there is no visa on arrival for this route. Apply online at least 7 business days ahead (single entry, 90 days, USD 25 fee). Airlines will deny boarding without an approved e-visa letter, printed."
    },
    "ADV-HAN-HEALTH": {
      "destination_id": "HAN",
      "topic": "health",
      "title": "Hanoi health notes",
      "content": "No mandatory vaccinations for US travelers. Typhoid and hepatitis A boosters are recommended. Tap water is not potable - drink bottled or boiled. Dengue advisories are active September-November; carry insect repellent with DEET."
    },
    "ADV-HAN-WEATHER": {
      "destination_id": "HAN",
      "topic": "weather",
      "title": "Late-monsoon conditions in northern Vietnam",
      "content": "Late September is the tail of the monsoon: hot, humid, with heavy afternoon downpours. Remnant typhoons occasionally cross the north; Ha Long Bay cruise operators cancel sailings in heavy swells - reconfirm any cruise 24 hours ahead."
    },
    "ADV-HAN-SAFETY": {
      "destination_id": "HAN",
      "topic": "safety",
      "title": "Hanoi safety advisory - Level 1",
      "content": "Exercise normal precautions. Petty theft and bag-snatching occur in the Old Quarter and around Hoan Kiem Lake. Use registered taxis or ride-hailing apps; agree fares in advance for cyclos."
    },
    "ADV-HAN-TRANSPORT": {
      "destination_id": "HAN",
      "topic": "transport",
      "title": "Getting around Hanoi",
      "content": "Noi Bai airport is 45-60 minutes from the Old Quarter by car. Ride-hailing (Grab) is widely used and cheap. Motorbike traffic is dense: cross streets at a steady pace and never step backwards."
    },
    "ADV-SEA-WEATHER": {
      "destination_id": "SEA",
      "topic": "weather",
      "title": "Seattle September weather",
      "content": "September in Seattle is mild and mostly dry (60-70F). Marine-layer clouds burn off by midday. Pack light layers and a compact rain shell."
    },
    "ADV-SEA-TRANSPORT": {
      "destination_id": "SEA",
      "topic": "transport",
      "title": "SEA airport to downtown",
      "content": "Link light rail runs from SEA airport to downtown in about 38 minutes; buy an ORCA card or tap a contactless card. Rideshare pickup is on the 3rd floor of the parking garage."
    },
    "ADV-SEA-SAFETY": {
      "destination_id": "SEA",
      "topic": "safety",
      "title": "Seattle safety advisory",
      "content": "Exercise normal precautions. Late at night avoid 3rd Ave between Pike and Pine; keep phones zipped in crowds at Pike Place Market."
    },
    "ADV-SEA-VISA": {
      "destination_id": "SEA",
      "topic": "visa",
      "title": "Domestic travel ID requirements",
      "content": "Seattle is a domestic destination for US travelers - no visa needed. A REAL ID-compliant license or passport is required for boarding US domestic flights."
    },
    "ADV-PDX-WEATHER": {
      "destination_id": "PDX",
      "topic": "weather",
      "title": "Portland September weather",
      "content": "Warm days, cool nights; wildfire smoke occasionally drifts in from the east in early September - check AQI before long outdoor walks."
    }
  },
